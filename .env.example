# Local anonymous mode
PORT=3000
HOST=127.0.0.1
# Optional override. Otherwise uses Gigadrive's GIGADRIVE_URL, then localhost.
# PUBLIC_URL=https://your-stable-host.example
# ALLOWED_ORIGINS=https://your-browser-client.example

# Hosted OAuth: configure Upstash and a Wynncraft application.
# Register <PUBLIC_URL or GIGADRIVE_URL>/oauth/callback in Wynncraft.
# WYNNCRAFT_OAUTH_CLIENT_ID=
# WYNNCRAFT_OAUTH_CLIENT_SECRET=
# WYNNCRAFT_OAUTH_SCOPES=identify main_access character_list_access character_data_access character_build_access online_status
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<full-access REST token>
# Optional alternative backend: REDIS_URL=rediss://...
# TRUST_PROXY_HOPS=1
# OAUTH_ENCRYPTION_KEY=<32 random bytes encoded as base64>

# Alternative single-user/shared-token mode (do not combine with hosted OAuth)
# WYNNCRAFT_API_TOKEN=
# MCP_API_KEY=<at least 32 random characters>
# Only enable after setting the token's Public Mode in the Wynncraft dashboard:
# WYNNCRAFT_TOKEN_PUBLIC_MODE=true

# Optional third-party market/history and reward pools (15 additional tools)
# Obtain your own read-only application key; never use the shared game-mod key.
# Requires hosted OAuth or MCP_API_KEY to protect the shared application quota.
# WYNNVENTORY_API_KEY=
