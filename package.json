{
  "name": "wynncraft-mcp",
  "version": "0.1.0",
  "description": "Stateless Streamable HTTP MCP server for the Wynncraft v3 API",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "api:update": "node scripts/update-api.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github:configure": "node scripts/configure-github.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
