        },
        "shiny": {
          "type": "boolean"
        },
        "tier": {
          "type": "integer",
          "minimum": 1
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional JSON Pointer projection and local array/object slicing. The raw v2 envelope is retained, so /data selects the upstream data. Use page/page_size for upstream pagination.",
          "properties": {
            "pointer": {
              "type": "string",
              "maxLength": 1024
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      },
      "required": [
        "item_name"
      ]
