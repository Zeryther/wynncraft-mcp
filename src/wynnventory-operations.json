  {
    "name": "wynnventory_listMarketListings",
    "path": "/market/listings",
    "method": "GET",
    "summary": "Live trade market listings",
    "parameters": [
      {
        "name": "item_name",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 256
        },
        "description": "Case-insensitive substring match on the item name."
      },
      {
        "name": "item_type",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "gear",
            "material",
            "ingredient",
            "powder",
            "rune",
            "dungeon_key",
            "amplifier",
            "emerald_pouch"
          ],
          "maxLength": 256
        }
      },
      {
        "name": "subtype",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 256
        },
        "description": "Lowercase sub-category, e.g. bow, helmet, ring, waterpowder, uthrune. Matched case-insensitively."
      },
      {
        "name": "rarity",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 256
        },
        "description": "Case-insensitive rarity filter."
      },
      {
        "name": "tier",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      {
        "name": "shiny",
        "in": "query",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "unidentified",
        "in": "query",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "timestamp_desc",
            "timestamp_asc",
            "listing_price_desc",
            "listing_price_asc",
            "overall_roll_desc",
            "overall_roll_asc"
          ],
          "default": "timestamp_desc",
          "maxLength": 256
        }
      },
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      {
        "name": "page_size",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    ],
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_name": {
          "type": "string",
          "maxLength": 256,
          "description": "Case-insensitive substring match on the item name."
        },
        "item_type": {
          "type": "string",
          "enum": [
            "gear",
            "material",
            "ingredient",
            "powder",
            "rune",
            "dungeon_key",
            "amplifier",
            "emerald_pouch"
          ],
          "maxLength": 256
        },
        "subtype": {
          "type": "string",
          "maxLength": 256,
          "description": "Lowercase sub-category, e.g. bow, helmet, ring, waterpowder, uthrune. Matched case-insensitively."
        },
        "rarity": {
          "type": "string",
          "maxLength": 256,
          "description": "Case-insensitive rarity filter."
        },
        "tier": {
          "type": "integer",
          "minimum": 1
        },
        "shiny": {
          "type": "boolean"
        },
        "unidentified": {
          "type": "boolean"
        },
        "sort": {
          "type": "string",
          "enum": [
            "timestamp_desc",
            "timestamp_asc",
            "listing_price_desc",
            "listing_price_asc",
            "overall_roll_desc",
            "overall_roll_asc"
          ],
          "default": "timestamp_desc",
          "maxLength": 256
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional JSON Pointer projection and local array/object slicing. The raw v2 envelope is retained, so /data selects the upstream data. Use page/page_size for upstream pagination.",
          "properties": {
            "pointer": {
